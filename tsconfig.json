{
   "extends": "$app/tsconfig",
   "compilerOptions": {
      "sourceMap": true,
      "strict": true
   },
   "include": [
      ".svelte-kit/ambient.d.ts",
      ".svelte-kit/types/**/$types.d.ts",
      "src/**/*.ts",
      "src/**/*.svelte",
      "src/types/**/*.d.ts",
      "eslint.config.ts",
      "svelte.config.js",
      "vite.config.ts"
   ],
   "exclude": ["node_modules"]
}
